# github for private
Host github
    User git
    Port 22
    HostName github.com
    IdentityFile ~/.ssh/id_ed25519
    TCPKeepAlive yes
    IdentitiesOnly yes

# github for school
Host github_school
    User git
    HostName github.com
    IdentityFile ~/.ssh/github_school
    TCPKeepAlive yes
    IdentitiesOnly yes

# gitlab for private
Host gitlab
    HostName gitlab.com
    IdentityFile ~/.ssh/id_ed25519
    User git

